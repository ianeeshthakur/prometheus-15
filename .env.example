# Copy to .env and fill in. Never commit the real .env.
#
# Server-side config only (server/core/config.py's load_dotenv() walks up from
# server/'s cwd and finds this file automatically -- no need to duplicate it inside
# server/). Client-side config lives in client/.env.example instead: Vite only reads
# .env files from its own project root, and client-side vars must be prefixed VITE_
# (never put a secret behind that prefix -- Vite inlines it into the built JS bundle).
DATABASE_URL=sqlite:///./gvista.db
HLS_OUTPUT_DIR=./hls_output
# Base URL for the official Sentinel-portal simulated-feed catalogue (docs/backend.md
# §2). Unset until organizers provide that live host.
INGEST_API_BASE_URL=
# A real hackathon test rig found 2026-09-13 (docs/backend.md §12.7) -- a flat GET at
# a fixed URL, e.g. https://cctv.corp8.cloud/cameras.json. Takes priority over
# INGEST_API_BASE_URL when set.
INGEST_CATALOGUE_URL=
# RTSP on that rig authenticates per-connection via a registered email+password
# embedded in the URL. NEVER put real values here -- this file is committed. Set real
# values only in your local, gitignored .env.
INGEST_STREAM_EMAIL=
INGEST_STREAM_PASSWORD=
INGEST_RTSP_HOST=
INGEST_RTSP_PORT=8554

