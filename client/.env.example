# Copy to .env (in this directory) and fill in if you need something other than the
# default. Vite only reads .env files from this project's own root, and only
# variables prefixed VITE_ are exposed to client code (see src/api/client.js) --
# never put a secret behind that prefix, Vite inlines it straight into the built JS
# bundle that ships to every browser.

# Where the client points its API calls. Defaults to http://localhost:8000 in
# src/api/client.js if unset, so this file is optional for local dev against a
# locally-running server/.
VITE_API_BASE_URL=http://localhost:8000
